# Copy to .env (repo root or backend/). Everything is optional; with no key the app runs fully offline.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# auto = Gemini if a key is set (falls back to the offline parser on API errors); or: gemini | heuristic
EXTRACTOR=auto
# DATABASE_URL=postgresql+psycopg://user:pass@host/db
CORS_ORIGINS=http://localhost:5173
# For cost reporting in evals only (USD per 1M tokens) - check your model's current pricing
LLM_PRICE_IN=0.30
LLM_PRICE_OUT=2.50
